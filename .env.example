# Copy to .env — never commit. Fill in your own Konnect PAT/org details.
# Get a PAT: https://cloud.konghq.com/global/account/tokens
KONNECT_TOKEN=kpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
KONNECT_SERVER_URL=eu.api.konghq.com
CONTROL_PLANE_NAME=kong-observability-demo

# Kong Gateway version. 3.13+ required for OTLP access logs (access_logs
# endpoint) — see README.md "Kong Gateway version requirement".
KONG_IMAGE_TAG=3.14.0.12

# Auto-populated by konnect-setup.sh after it creates the control plane —
# leave unset here. Used to render values-dp.yaml from values-dp.yaml.tpl.
# CONTROL_PLANE_ENDPOINT=
# CONTROL_PLANE_TELEMETRY=
